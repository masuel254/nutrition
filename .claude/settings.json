{
  "permissions": {
    "allow": [
      "Bash(node tools/:*)",
      "Bash(node tests/e2e.mjs)",
      "Bash(node n8n/run_tests.mjs)",
      "Bash(npm test)",
      "Bash(npm run test:n8n)",
      "Bash(npm run bump)",
      "Bash(npm run secrets)",
      "Bash(npm run layout)",
      "Bash(python tools/layout.py:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/hook_git_guard.mjs\""
          }
        ]
      }
    ]
  }
}